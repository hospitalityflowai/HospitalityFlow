# Copy to .env.local (gitignored), then run: npm run build
# Use the anon public or publishable key — never the service_role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# Live RLS isolation suite (names only — values go in .env.rls-test, gitignored)
# Prefer copying .env.rls-test.example → .env.rls-test
# Docs: docs/security/LIVE_RLS_TEST_SETUP.md
# NEVER point HF_RLS_TEST_* at production / Zetter / customer projects.
# ---------------------------------------------------------------------------
# HF_RLS_TEST_ENV=non-production
# HF_RLS_TEST_SUPABASE_URL=
# HF_RLS_TEST_ANON_KEY=
# HF_RLS_TEST_SERVICE_ROLE_KEY=
# HF_RLS_TEST_HOTEL_A_OWNER_EMAIL=
# HF_RLS_TEST_HOTEL_A_OWNER_PASSWORD=
# HF_RLS_TEST_HOTEL_B_OWNER_EMAIL=
# HF_RLS_TEST_HOTEL_B_OWNER_PASSWORD=
# HF_RLS_TEST_OPERATOR_EMAIL=
# HF_RLS_TEST_OPERATOR_PASSWORD=
# HF_RLS_TEST_REVOKED_EMAIL=
# HF_RLS_TEST_REVOKED_PASSWORD=
# HF_RLS_TEST_HOTEL_A_STAFF_EMAIL=
# HF_RLS_TEST_HOTEL_A_STAFF_PASSWORD=
# HF_RLS_TEST_ASSUME_LOCAL_DEV_FLAGS_ONLY=1
