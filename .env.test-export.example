# Copy to .env.test-export (gitignored), then run:
#   node scripts/export-test-handovers.mjs --workspace <uuid> --dry-run ...
#
# Use the anon/publishable key + a workspace MEMBER account.
# RLS decides which handover_reports rows are visible.
# NEVER put a service_role key here. This tool will refuse service-role keys.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

TEST_EXPORT_EMAIL=member-on-target-workspace@example.com
TEST_EXPORT_PASSWORD=replace-with-strong-password
